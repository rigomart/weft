{
  "name": "weft",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt --write",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "turbo run test && bun test ./tooling",
    "verify": "bun tooling/verify/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
