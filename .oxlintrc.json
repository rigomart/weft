{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["prototype/**"],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/core/**",
        "packages/store/**",
        "packages/contracts/**"
      ],
      "plugins": ["import"],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["bun:*", "!bun:test"],
                "message": "core, store and contracts run on every host: no Bun-only API (ADR 0005, ADR 0010)."
              },
              {
                "group": ["electron", "electron/**", "@electron/**"],
                "message": "core, store and contracts never import Electron; the desktop host does (ADR 0005, ADR 0008, ADR 0010)."
              },
              {
                "group": [
                  "@libsql/**",
                  "libsql",
                  "libsql/**",
                  "better-sqlite3",
                  "better-sqlite3/**",
                  "sqlite3",
                  "sqlite3/**",
                  "@sqlite.org/**",
                  "wa-sqlite",
                  "wa-sqlite/**",
                  "expo-sqlite",
                  "expo-sqlite/**",
                  "@op-engineering/**"
                ],
                "message": "core, store and contracts reach the database only through the database seam; each host provides the driver (ADR 0005)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@weft/core",
                  "@weft/core/**",
                  "@weft/store",
                  "@weft/store/**",
                  "@weft/database-*",
                  "@weft/database-*/**"
                ],
                "message": "The interface reaches Weft only through @weft/contracts (ADR 0010)."
              }
            ]
          }
        ]
      }
    }
  ]
}
