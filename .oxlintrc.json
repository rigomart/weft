{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["prototype/**"],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["packages/core/**", "packages/store/**"],
      "plugins": ["import"],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["bun:*", "!bun:test"],
                "message": "core and store run on every host: no Bun-only API (ADR 0005)."
              },
              {
                "group": ["electron", "electron/**", "@electron/**"],
                "message": "core and store never import Electron; the desktop host does (ADR 0005, ADR 0008)."
              },
              {
                "group": [
                  "@libsql/**",
                  "libsql",
                  "libsql/**",
                  "better-sqlite3",
                  "better-sqlite3/**",
                  "sqlite3",
                  "sqlite3/**",
                  "@sqlite.org/**",
                  "wa-sqlite",
                  "wa-sqlite/**",
                  "expo-sqlite",
                  "expo-sqlite/**",
                  "@op-engineering/**"
                ],
                "message": "core and store reach the database only through the database seam; each host provides the driver (ADR 0005)."
              }
            ]
          }
        ]
      }
    }
  ]
}
